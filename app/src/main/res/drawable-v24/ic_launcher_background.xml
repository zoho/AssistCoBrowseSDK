<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand-blue tile with the same top-left → bottom-right ramp the legacy PNG
  mipmaps use (#2E6CCB → #13408C, with md_primary #1F5BB7 as the mid-tone).
  Vector gradients need API 24, hence the -v24 qualifier; `drawable/` holds the
  flat fallback.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#2E6CCB" />
                <item android:offset="1" android:color="#13408C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
