.DS_Store
*/.DS_Store
*/*/.DS_Store
*/*/*/.DS_Store
*/*/*/*/.DS_Store

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration — sdk.dir AND the CoBrowse widget code (a credential).
# local.properties.sample is the tracked template; this file never is.
local.properties

# NOTE: the Gradle wrapper (gradlew, gradlew.bat, gradle/wrapper/*) is
# deliberately TRACKED. It pins the Gradle version so a fresh clone builds
# reproducibly without a local Gradle install.

# Vendored SDK binaries, if anyone drops one here again. The SDK comes from the
# published com.zoho.assist:cobrowse artifact on maven.zohodl.com.
app/libs/*.aar

# Local QA tooling, not part of the sample.
tools/sdk-backups/
tools/join-session.sh
tools/join_result.png

# Python bytecode
__pycache__/

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
# The whole directory: nothing in it is shared config for this project, and listing
# individual children left `.idea/` itself showing up as untracked forever.
*.iml
.idea/

# Keystore files — never commit signing material.
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
